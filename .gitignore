# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
dist
tmp
/out-tsc
# Match .dockerignore: a bare `.env` rule misses every variant, and tooling that
# writes .env.local / .env.backup / .env.<timestamp> would leave a real secret
# one `git add -A` away from a public repo.
.env
.env.*
**/.env
**/.env.*
# Negations must come last: git applies the final matching rule, so putting
# this above the **/.env.* line would leave the example file ignored.
!.env.example
!**/.env.example
# dependencies
node_modules
# pnpm drops a store here when its configured one is on another filesystem.
.pnpm-store

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*

# IDE - VSCode
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data

# Next.js
.next

# Vim files
**/*.swp
**/*.swo

# Temporary files
*.orig
*.~*~
*.tsbuildinfo

# ignore Secrets folder
.secrets/
libraries/plugins/src/plugins.ts
i18n.cache

# Generated by apps/frontend/scripts/fetch-gtm.mjs on install
apps/frontend/public/g.js
# Generated by apps/frontend/scripts/fetch-fbevents.mjs on install
apps/frontend/public/f.js

# UI migration working material — deliberately not published.
#
# This repository is public. The handoff carries an unreleased redesign, a
# pricing table that has not been announced and internal design notes; the
# screenshots carry whatever is in the local database (emails, organisation
# names) and run to ~8 MB per step. Both are regenerable working material
# rather than deliverables — docs/ui-migration-log.md is the record that ships.
design/handoff/
docs/ui-shots/
