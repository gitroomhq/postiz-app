# postmonster - production environment example
# Copy these values into the Coolify environment of the "app" service
# (Docker Compose resource) or into a local .env for `docker compose --env-file`.
# NEVER commit a filled .env file.

# === Image
# Tag from ghcr.io/fiveppm/postmonster to run. CI publishes:
#   latest, <semver> (v1.2.3 -> 1.2.3), <major>.<minor>, sha-<commit>
POSTMONSTER_IMAGE_TAG=latest

# === Required URLs (exactly as the app is reached, NO trailing slash)
MAIN_URL=https://app.postmonster.xyz
FRONTEND_URL=https://app.postmonster.xyz
# Public backend URL as seen by the browser (nginx proxies /api/ -> backend).
# NOTE: baked into the Next.js bundle at image build time; keep in sync with
# the build args in .github/workflows/build-image.yml.
NEXT_PUBLIC_BACKEND_URL=https://app.postmonster.xyz/api
# Backend URL for server-to-server calls from inside the container.
BACKEND_INTERNAL_URL=http://localhost:3000

# === Secrets
# Long random string, unique per install: e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string

# === Databases (service names from deploy/docker-compose.coolify.yml)
DATABASE_URL=postgresql://postiz-user:postiz-password@postgres:5432/postiz-db
POSTGRES_USER=postiz-user
POSTGRES_PASSWORD=postiz-password
POSTGRES_DB=postiz-db
REDIS_URL=redis://redis:6379

# === Temporal (internal)
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=temporal

# === App behaviour
IS_GENERAL=true
# Early Access: registration is invite-only (see docs/deploy.md)
DISABLE_REGISTRATION=true
# Public API hourly rate limit
API_LIMIT=30
# NEVER set NOT_SECURED in production (relaxes cookie security, dev-only).

# === Storage (local persistent volume, served at https://<host>/uploads/)
STORAGE_PROVIDER=local
# Container filesystem path of the uploads volume
UPLOAD_DIRECTORY=/uploads
# Public path segment used when composing media URLs (no slashes).
# NOTE: this is the name the code reads (NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY).
# The upstream docker-compose.yaml's NEXT_PUBLIC_UPLOAD_DIRECTORY is a stale
# variable name that no code reads - do not use it.
NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=uploads

# === Email
# Providers: "resend" | "nodemailer" (SMTP) | unset = no email at all.
# With a provider configured, local (email+password) users must activate
# their account by email.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@postmonster.xyz
EMAIL_FROM_NAME=Postmonster
# SMTP alternative - use EMAIL_PROVIDER=nodemailer and fill these instead:
# EMAIL_HOST=mail.postmonster.xyz
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=
# EMAIL_PASS=

# === TikTok (Content Posting API)
# Redirect URI to register in the TikTok Developer Portal:
#   https://app.postmonster.xyz/integrations/social/tiktok
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# TikTok Business (optional, separate app)
TIKTOK_BUSINESS_CLIENT_ID=
TIKTOK_BUSINESS_CLIENT_SECRET=
# While the TikTok integration is unaudited, posts are forced private and the
# composer shows the "under review" notice. Set to true only after TikTok
# approves the app for public Direct Post.
TIKTOK_AUDITED=false

# === Other social networks (optional - leave empty to hide the provider)
X_URL=
X_API_KEY=
X_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
BEEHIIVE_API_KEY=
BEEHIIVE_PUBLICATION_ID=
LISTMONK_DOMAIN=
LISTMONK_USER=
LISTMONK_API_KEY=
LISTMONK_LIST_ID=
THREADS_APP_ID=
THREADS_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=
TUMBLR_CLIENT_ID=
TUMBLR_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN_ID=
SLACK_ID=
SLACK_SECRET=
SLACK_SIGNING_SECRET=
MASTODON_URL=https://mastodon.social
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
# Farcaster sign-in (Neynar)
NEYNAR_CLIENT_ID=
NEYNAR_SECRET_KEY=
NEYNAR_APP_FID=
NEYNAR_APP_MNEMONIC=
NEYNAR_SPONSOR_SIGNERS=false
# Chrome extension id (cookie-based integrations)
EXTENSION_ID=

# === Optional AI
OPENAI_API_KEY=
