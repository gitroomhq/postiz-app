# Configuration reference: https://docs.postqueen.ai/configuration/reference

# === Required Settings
# These match the containers started by `pnpm run dev:docker` (docker-compose.dev.yaml).
DATABASE_URL="postgresql://postqueen-local:postqueen-local-pwd@localhost:5432/postqueen-db-local"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="random string for your JWT secret, make it long"
# Key for data encrypted at rest: integration OAuth and refresh tokens, provider
# credentials, stored cookies. Keep it SEPARATE from JWT_SECRET — they used to be
# the same value, which meant rotating the signing key silently made every
# connected social account undecryptable. Falls back to JWT_SECRET when unset, so
# an existing install keeps working; set it before you have real data.
# ENCRYPTION_KEY=""
# The key this data was encrypted under BEFORE the current one. Set this to the
# old value whenever you change ENCRYPTION_KEY — or before rotating JWT_SECRET
# on an install that predates ENCRYPTION_KEY — otherwise rows nothing happens to
# rewrite become permanently unreadable. Remove it once everything has been
# re-encrypted under the current key.
# PREVIOUS_ENCRYPTION_KEY=""

# Apply the schema with `prisma migrate deploy` instead of `db push`. Leave unset
# and startup behaves exactly as before. `db push --accept-data-loss` reconciles
# whatever the schema says on every boot, which is convenient for development and
# unforgiving with real data; migrations give you a reviewable, ordered history.
# To switch an existing database over, baseline it once:
#   prisma migrate resolve --applied 0_init
# Unset, empty, "false" or "0" keeps db push; any other value uses migrations,
# so a typo errs toward the non-destructive path.
# PRISMA_MIGRATE=true

# === This needs to be exactly the URL you're accessing PostQueen on
FRONTEND_URL="http://localhost:4200"
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"
BACKEND_INTERNAL_URL="http://localhost:3000"
# Added to the CORS allow-list alongside FRONTEND_URL, and surfaced in the UI.
# Falls back to FRONTEND_URL when unset.
MAIN_URL="http://localhost:4200"

# Where Temporal listens. `pnpm run dev:docker` publishes it on localhost:7233;
# inside a container on the same compose network use "temporal:7233" instead.
# Scheduling runs through Temporal, so nothing publishes without it.
TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="default"
## Temporal Cloud, or any server behind TLS. Both are unset for the local
## container above. TEMPORAL_TLS is compared to the exact string "true"; any
## other value, including "1", leaves TLS off.
#TEMPORAL_TLS="true"
#TEMPORAL_API_KEY=""
## Which task queues this worker refuses to serve, comma separated. Unset means
## it serves all of them, which is what a single-node install wants. Use it to
## give one queue its own machine.
#EXCLUDE_QUEUE=""
## Divides the worker's computed concurrency. Raise it on a small box where the
## default saturates memory; 1 (the default) leaves concurrency as calculated.
#WORKER_CONCURRENCY_DIVIDER=1
## Starts the recurring workflows: the missing-post sweep, and the founding-fee
## sweep when billing is on. Read by the BACKEND, which registers them when it
## boots, not by the orchestrator. Set it on exactly ONE backend instance: every
## instance that has it races to start the same workflow ids. Any non-empty
## value turns it on, "false" included; leave it unset to turn it off. Unset
## means the sweep never runs, so posts that failed to schedule are never picked
## back up. The docker-compose setup sets it to true.
#RUN_CRON=true
## Where the orchestrator's health endpoint listens. Defaults to 3002.
#ORCHESTRATOR_PORT=3002

# Only the Next dev server locally, with /api proxied to a backend that is
# already running elsewhere (for example the Compose stack on port 4007).
# Pair it with NEXT_PUBLIC_BACKEND_URL="/api".
#DEV_BACKEND_PROXY="http://localhost:4007"

## Remember to set your public internet IP address in the allow-list for the API token.
##
## Cloudflare is currently required to save things like social media avatars for accounts.
CLOUDFLARE_ACCOUNT_ID="your-account-id"
CLOUDFLARE_ACCESS_KEY="your-access-key"
CLOUDFLARE_SECRET_ACCESS_KEY="your-secret-access-key"
CLOUDFLARE_BUCKETNAME="your-bucket-name"
## Where media is READ from. Stored with every media row and handed to the
## social networks — several of them fetch this address themselves rather than
## accepting the file from you, so it must be reachable without a signature.
## Three options, in order of preference:
##   1. Your own app:  https://your-host/api/uploads
##      Served by the application from a private bucket. Your domain, no rate
##      limit, and the bucket never has to be public. Costs your bandwidth.
##   2. A custom domain on the bucket:  https://media.example.com
##      Cheapest and fastest, but needs the domain hosted at Cloudflare.
##   3. The r2.dev development URL:  https://pub-your-hash.r2.dev
##      Works, but Cloudflare rate-limits it and calls it unfit for production,
##      and networks that require domain verification cannot verify it.
## Never the S3 API endpoint (…r2.cloudflarestorage.com) — it refuses unsigned
## reads, so every image would break.
CLOUDFLARE_BUCKET_URL="https://pub-your-hash.r2.dev"
CLOUDFLARE_REGION="auto"
## Only for buckets created with a jurisdiction ("eu" for data residency under
## GDPR). Such a bucket is reachable only through its own endpoint, and leaving
## this unset makes it look like the bucket does not exist. Blank for a normal
## bucket, which is what most installs have.
CLOUDFLARE_JURISDICTION=""

# === Common optional Settings

## Email. EMAIL_PROVIDER must be set explicitly to "resend" or "nodemailer";
## any other value — including leaving it unset — silently selects a provider
## that sends nothing, and password resets then report success while no mail
## goes out. Without a working provider, passwordless login is unavailable and
## new accounts are activated without email verification.
#EMAIL_PROVIDER="resend"
## Resend: create your own key, the value below is a placeholder.
#RESEND_API_KEY="re_your_key_here"
#EMAIL_FROM_ADDRESS=""
#EMAIL_FROM_NAME=""
## Nodemailer instead of Resend:
#EMAIL_HOST=""
#EMAIL_PORT=""
#EMAIL_SECURE="true"
#EMAIL_USER=""
#EMAIL_PASS=""
#DISABLE_REGISTRATION=false

# Where will social media icons be saved - local or cloudflare.
STORAGE_PROVIDER="local"

## Post files to the backend and let it write them to storage, instead of having
## the browser upload straight to the bucket with a presigned URL. Only affects
## STORAGE_PROVIDER="cloudflare"; local storage already works this way.
##
## Direct uploads are faster and cost the server no bandwidth, but they break
## whenever something rewrites the request on its way out — a privacy extension
## trimming query parameters is enough to invalidate the signature. R2 then
## answers 403 without CORS headers, and the browser reports it as a CORS error
## that says nothing about the cause. Turn this on locally / for affected users
## if uploads fail that way.
##
## Do NOT flip the production default to true without measuring bandwidth and
## origin load — the silent default remains direct-to-bucket (this line commented).
#UPLOAD_VIA_SERVER=true
## Where uploads are spooled while being written to storage. Defaults to the
## system temp directory. They are deleted as soon as storage has them.
#UPLOAD_TMP_DIR=""

## Local storage (STORAGE_PROVIDER="local") writes uploads here. In the Docker
## image it must stay /uploads: the bundled nginx serves that path directly, and
## any other value writes files it never serves.
#UPLOAD_DIRECTORY="/uploads"

## The public path uploads are served under, without slashes ("uploads" in the
## Docker image, matching the nginx location).
##
## Local storage saves each file's full URL (FRONTEND_URL + /uploads/...) in the
## database. Changing FRONTEND_URL later (a new domain, http to https, another
## port) leaves the old URLs pointing at the old address, so existing media stops
## loading and can no longer be published. After a move, list the old address in
## PREVIOUS_FRONTEND_URLS below.
#NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY="uploads"

## Addresses this instance used to run under, comma-separated, each written in
## full (for example "http://localhost:4007,https://old.example.com"). On boot,
## upload URLs stored under them are moved to the current FRONTEND_URL: the media
## library, posts, drafts and channel avatars all follow. An address is skipped,
## with a warning in the backend log, when none of its newest files exist under
## UPLOAD_DIRECTORY. Safe to leave set once the move is done.
#PREVIOUS_FRONTEND_URLS=""

