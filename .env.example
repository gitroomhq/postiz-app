## once Listmonk is configured the send is attempted on every subscribe, so an
## empty value posts an invalid template_id that Listmonk rejects — silently,
## because the whole block sits in an empty catch. Set it to a real id.
LISTMONK_WELCOME_TEMPLATE_ID=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_BUSINESS_CLIENT_ID=""
TIKTOK_BUSINESS_CLIENT_SECRET=""
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
DRIBBBLE_CLIENT_ID=""
DRIBBBLE_CLIENT_SECRET=""
TUMBLR_CLIENT_ID=""
TUMBLR_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN_ID=""
SLACK_ID=""
SLACK_SECRET=""
SLACK_SIGNING_SECRET=""
MASTODON_URL="https://mastodon.social"
MASTODON_CLIENT_ID=""
MASTODON_CLIENT_SECRET=""
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
GOOGLE_GMB_CLIENT_ID=""
GOOGLE_GMB_CLIENT_SECRET=""
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
## Kick signs its secret as KICK_SECRET, not KICK_CLIENT_SECRET.
KICK_CLIENT_ID=""
KICK_SECRET=""
VK_ID=""
WHOP_CLIENT_ID=""
## Farcaster goes through Neynar, so these are Neynar's credentials, not
## Farcaster's. There is no redirect URI: the provider hands the client id
## straight to the sign-in widget rather than building a callback path.
NEYNAR_CLIENT_ID=""
NEYNAR_SECRET_KEY=""
MEWE_HOST=""
MEWE_APP_ID=""
MEWE_API_KEY=""
## Telegram takes a BotFather token and the bot's @name, not an OAuth pair.
TELEGRAM_TOKEN=""
TELEGRAM_BOT_NAME=""

# Chrome Extension Settings (for cookie-based platform integrations like Skool).
# This must be the id Chrome gives the extension, or the cookie hand-off fails
# with nothing on screen. In production that is the id the Web Store assigns.
# Loading the unpacked build uses the public key in
# apps/extension/manifest.dev.json instead, which pins the id to
# gclbjdbkakfndpofanknmccecjlmleah.
EXTENSION_ID=""

# Misc Settings
OPENAI_API_KEY=""
# OAuth client configured for the ChatGPT app. Only this client can receive
# verified user email claims for ChatGPT Enterprise domain restrictions.
OPENAI_OAUTH_CLIENT_ID=""
# MCP OAuth Dynamic Client Registration (RFC 7591) redirect-domain allowlist.
# When set (comma separated), POST /oauth/register only accepts redirect_uris
# whose host matches a listed domain or one of its subdomains; unset or empty
# means any client can self-register. Only https callbacks are checked:
# loopback (http://localhost:8787/callback - Grok, Claude Code) and
# private-use scheme callbacks (cursor://...) stay on the user's machine
# and are always accepted. Example locks web callbacks to the claude.ai
# connector; add cursor.com for Cursor.
# DCR_VERIFIED_DOMAINS="claude.ai,claude.com"
NEXT_PUBLIC_POLOTNO=""
# Lets the AI Copilot search the web. Without it the agent still answers, it
# just has no search tool.
#TAVILY_API_KEY=""
# Shared secret for POST /public/agent, the unauthenticated agent endpoint.
# Unset means that route refuses every request, which is the right default —
# leaving it unset is how you keep the endpoint closed.
#AGENT_API_KEY=""

# --- Behaviour toggles. Each is read as "is it set at all", not for its value,
# --- so `=false` still turns the thing ON. Comment the line out instead.
# Reject sign-ups whose email contains "+". Blocks the usual trick for making
# unlimited addresses from one inbox, and also blocks people whose real address
# happens to contain a plus.
#DISALLOW_PLUS=true
# Remove links from posts going to X. X demotes posts with outbound links, so
# some accounts prefer to put them in a reply instead.
#STRIP_LINKS_FROM_X_POSTS=true
# Upload images at original size rather than compressing in the browser.
#DISABLE_IMAGE_COMPRESSION=true
# Hide the X analytics tab, which needs an API tier not every account has.
#DISABLE_X_ANALYTICS=true
# Public API only: refuse posts whose image paths do not contain this string.
# A substring test, not a domain parse — set it to your own media host to stop
# the API being used to post images hosted anywhere else.
#RESTRICT_UPLOAD_DOMAINS=""
# Deep-link scheme the mobile OAuth callback redirects to.
# Defaults to postqueen://auth/callback.
#MOBILE_APP_SCHEME=""

# AI video generation. Each provider is enabled only when all of its keys are
# present, and the check runs at import time — add a key and restart the
# backend. With none set, "Generate video" still opens and reports that no
# provider is configured.
# Video generation through EvoLink (https://evolink.ai) — one key is enough:
EVOLINK_API_KEY=""
# Image Text Slides — needs all four of these plus OPENAI_API_KEY above:
ELEVENSLABS_API_KEY=""
TRANSLOADIT_AUTH=""
TRANSLOADIT_SECRET=""
FAL_KEY=""
# Transloadit is also the browser-side uploader, and that path needs a template
# id as well as the auth key — the frontend only enables it when AUTH and
# TEMPLATE are both set, so with the key alone nothing changes and no error is
# reported.
TRANSLOADIT_TEMPLATE=""
# Set to "true" ONLY for local HTTP development: it drops secure/httpOnly/
# sameSite from the auth cookie. Any other value (including "false") keeps the
# cookie protected.
# NOT_SECURED=true
API_LIMIT=30 # The limit of the public API hour limit
# Counted per hour, per organization, on public-API posting. Uploads, in the
# app and through the public API, have their own hourly allowance instead:
# UPLOAD_LIMIT, 300 when unset, so choosing many files at once is not capped
# at API_LIMIT. Both are shared across backend instances when REDIS_URL is set;
# without it each process counts on its own.
# UPLOAD_LIMIT=300

# When connecting providers that take a self-hosted URL (WordPress, Mastodon,
# Lemmy, Listmonk, Bluesky PDS, etc.) PostQueen fetches that URL server-side and
# blocks requests that resolve to private/internal/loopback/link-local IPs to
# prevent SSRF. Set to true ONLY if your PostQueen instance must reach those
# services on a trusted private network (e.g. same Docker network or VPC).
# DISABLE_SSRF_PROTECTION=false

# Payment settings
FEE_AMOUNT=0.05
# Billing needs BOTH of the first two, and the key itself picks the mode:
# pk_test_/sk_test_ run against Stripe's test data, pk_live_/sk_live_ against
# real money. There is no separate test slot — one install, one mode. With only
# one of them set, isBillingEnabled() reports false and the whole app behaves as
# if billing were off, which is deliberate: a half-configured install is worse
# than either state.
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
# Returned by Stripe when you register the webhook endpoint (or shown in the
# Dashboard under Developers -> Webhooks). Must belong to the same mode as the
# keys above; a test-mode secret cannot verify live events. Without it every
# subscription event is rejected and paying customers never get their tier.
STRIPE_SIGNING_KEY=""
# RevenueCat (App Store / Google Play subscriptions from the mobile app)
# Webhook URLs: {BACKEND_URL}/payment/stripe and {BACKEND_URL}/payment/revenuecat, Authorization header value = REVENUECAT_WEBHOOK_SECRET
REVENUECAT_SECRET_KEY=""
REVENUECAT_WEBHOOK_SECRET=""
# IN_APP_PURCHASE_REJECT_SANDBOX=true

# Reseller / white-label endpoints: POST /enterprise/create-user, /enterprise/url,
# /enterprise/delete-channel and /public/modify-subscription. They are
# unauthenticated on purpose — the caller is another system, not a browser — and
# they authorize on a JWT signed with THIS key.
#
# It must not be JWT_SECRET. Tokens signed with JWT_SECRET include the session
# cookie, which carries no expiry and declares no purpose, so sharing the key
# would let any logged-in user replay their own cookie at /enterprise/create-user
# and receive an organization on a lifetime AGENCY plan, API key included.
#
# Leave it unset unless you actually run a reseller integration. Unset, all four
# routes refuse.
#ENTERPRISE_SECRET=""

# === Passwordless login + security (all optional) ===
# Offer an emailed 6-digit code as a second way to sign in, next to the password
# on the sign-in screen. Leave unset for password + OAuth only (default).
# Requires an EMAIL_PROVIDER so the codes can be delivered.
#
# Sign-up is never affected: new accounts always use email + password and get
# straight into the app. Waiting on mail at the moment somebody has just decided
# to try the product is the expensive place to spend it, whereas signing in is
# rare and is exactly when a password has been forgotten.
# PASSWORDLESS_LOGIN=true

# Solana wallet sign-in (Phantom and the rest). Off unless you set this.
# It used to appear whenever Stripe was configured, which put Continue with
# Wallet on hosted PostQueen. Billing and wallet login are separate.
# WALLET_LOGIN=true

# Make email+password sign-ups click a link in their inbox before they can log
# in. Off by default: a new account goes straight into the app. Turning this on
# also needs an EMAIL_PROVIDER, otherwise the link can never be delivered and
# every new account is locked out. Only affects email+password sign-ups; OAuth
# has already proven the address.
# REQUIRE_EMAIL_ACTIVATION=true

# Cloudflare Turnstile. BOTH keys are needed for the captcha to mean anything:
# the site key renders the widget, the secret key is what actually verifies the
# answer. Setting only the site key gives you a widget nobody checks.
# TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET=""

# Abuse limits for the passwordless login endpoints. These are on by default
# and need no configuration; the values below are the defaults. Set a limit to
# 0 to switch that dimension off.
# GUARD_WINDOW_MS=900000
# GUARD_OTP_REQUEST_EMAIL=5
# GUARD_OTP_REQUEST_IP=30
# GUARD_OTP_VERIFY_EMAIL=10
# GUARD_OTP_VERIFY_IP=60
# GUARD_LOGIN_EMAIL=20
# GUARD_LOGIN_IP=60
# GUARD_REGISTER_EMAIL=5
# GUARD_REGISTER_IP=20
# GUARD_FORGOT_EMAIL=5
# GUARD_FORGOT_IP=20
# Which actions require a captcha when TURNSTILE_SECRET is set.
# GUARD_CAPTCHA_ACTIONS="otp_request"
#
# Limits are shared across backend instances when REDIS_URL is set; without it
# each process counts on its own.

# Developer Settings
NX_ADD_PLUGINS=false
IS_GENERAL="true" # required for now
NEXT_PUBLIC_POSTQUEEN_OAUTH_DISPLAY_NAME="Authentik"
NEXT_PUBLIC_POSTQUEEN_OAUTH_LOGO_URL="https://raw.githubusercontent.com/walkxcode/dashboard-icons/master/png/authentik.png"
POSTQUEEN_GENERIC_OAUTH="false"
POSTQUEEN_OAUTH_URL="https://auth.example.com"
POSTQUEEN_OAUTH_AUTH_URL="https://auth.example.com/application/o/authorize"
POSTQUEEN_OAUTH_TOKEN_URL="https://auth.example.com/application/o/token"
POSTQUEEN_OAUTH_USERINFO_URL="https://authentik.example.com/application/o/userinfo"
POSTQUEEN_OAUTH_CLIENT_ID=""
POSTQUEEN_OAUTH_CLIENT_SECRET=""

# Short Link Service Settings
# DUB_TOKEN="" # Your self-hosted Dub API token
# DUB_API_ENDPOINT="https://api.dub.co" # Your self-hosted Dub API endpoint
# DUB_SHORT_LINK_DOMAIN="dub.sh" # Your self-hosted Dub domain

# SHORT_IO_SECRET_KEY="" # Your Short.io API secret key

# KUTT_API_KEY="" # Your Kutt.it API key
